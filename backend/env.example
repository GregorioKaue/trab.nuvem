# Copie este arquivo para ".env" e preencha com os dados do painel do alwaysdata
# (Bancos de dados > MySQL). NUNCA envie o .env para o GitHub.

# --- Banco de dados MySQL no alwaysdata ---
DB_HOST=mysql-SUACONTA.alwaysdata.net
DB_PORT=3306
DB_USER=SUACONTA_usuario
DB_PASSWORD=troque-esta-senha
DB_NAME=SUACONTA_educonnect

# --- Segurança ---
# Gere uma chave longa e aleatória, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# Origens do frontend autorizadas a chamar a API (separadas por vírgula).
# Se o próprio Node servir o site (FRONTEND_DIR abaixo), pode deixar vazio.
CORS_ORIGIN=https://SUACONTA.alwaysdata.net

# --- Frontend (opcional) ---
# Caminho da pasta que contém Indexescola.html e a pasta "pages".
# Mantenha o backend FORA dessa pasta, para não expor o .env e o server.js.
FRONTEND_DIR=../site

# --- Dados de demonstração ---
# true cria 1 professor e 1 aluno de exemplo se o banco estiver vazio.
# Depois do primeiro uso, coloque false e troque/apague as senhas de exemplo.
SEED_DEMO=true

# Porta local (no alwaysdata, as variáveis PORT e IP são definidas automaticamente)
PORT=3000
